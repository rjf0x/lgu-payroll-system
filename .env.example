APP_NAME="LGU Payroll System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_PAYSLIP_GENERATION=false
TRUSTED_PROXIES=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BLOCKCHAIN_DRIVER=simulated
BLOCKCHAIN_NETWORK=LGU-Simulated-Network
BLOCKCHAIN_CONTRACT_ADDRESS=
BESU_RPC_URL=http://127.0.0.1:28545
BESU_SIGNER_URL=http://127.0.0.1:29000
BESU_CHAIN_ID=1337
BESU_FROM_ADDRESS=
BESU_GAS=0x30d40
BESU_GAS_PRICE=0x0

# Opt-in versioned registry capture; configure the Phase 3 bridge and deploy the registry first.
PAYROLL_REGISTRY_ENABLED=false
PAYROLL_REGISTRY_ORGANIZATION_ID=
PAYROLL_REGISTRY_BRIDGE_URL=http://127.0.0.1:3100
PAYROLL_REGISTRY_BRIDGE_TOKEN=
PAYROLL_REGISTRY_CHAIN_ID=
PAYROLL_REGISTRY_GENESIS_HASH=
PAYROLL_REGISTRY_CONTRACT_ADDRESS=
PAYROLL_REGISTRY_CODE_HASH=
PAYROLL_REGISTRY_SIGNER_ADDRESS=
PAYROLL_REGISTRY_DEPLOYMENT_BLOCK=
PAYROLL_REGISTRY_STALE_AFTER_SECONDS=600
PAYROLL_REGISTRY_MAX_BLOCK_AGE_SECONDS=60
PAYROLL_REGISTRY_VALIDATOR_OWNER=
PAYROLL_REGISTRY_SIGNER_OWNER=
PAYROLL_REGISTRY_PAYROLL_OWNER=
