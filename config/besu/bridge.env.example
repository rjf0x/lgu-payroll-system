# Copy to a private, ignored environment file; never commit populated credentials.
# Start with: node --env-file=<private-file> config/besu/bridge.mjs
BESU_BRIDGE_PORT=3100
BESU_BRIDGE_TOKEN=
BESU_BRIDGE_RPC_URL=http://127.0.0.1:28545
BESU_BRIDGE_SIGNER_URL=http://127.0.0.1:29000
BESU_BRIDGE_CHAIN_ID=1337
BESU_BRIDGE_GENESIS_HASH=
BESU_BRIDGE_CONTRACT_ADDRESS=
BESU_BRIDGE_CODE_HASH=
BESU_BRIDGE_SIGNER_ADDRESS=
BESU_BRIDGE_DEPLOYMENT_BLOCK=
BESU_BRIDGE_GAS_PRICE=0
# Optional: use a separate persistent journal for each signer/network/contract identity.
# BESU_BRIDGE_JOURNAL_FILE=storage/app/private/besu/bridge.sqlite
