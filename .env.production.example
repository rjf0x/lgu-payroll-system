APP_NAME="LGU Payroll System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DISPLAY_TIMEZONE=Asia/Manila
APP_URL=https://payroll.example.invalid

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lgu_payroll_production
DB_USERNAME=payroll_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_PAYSLIP_GENERATION=true
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local

TRUSTED_PROXIES=
BLOCKCHAIN_DRIVER=besu
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_CONTRACT_ADDRESS=
BESU_RPC_URL=
BESU_SIGNER_URL=
BESU_CHAIN_ID=
BESU_FROM_ADDRESS=
BESU_GAS=0x30d40
BESU_GAS_PRICE=0x0

# Set only for first bootstrap, then remove and rebuild config cache.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Leave unset until MAO confirms applicability of the existing monthly tax/contribution method.
PAYROLL_SUPPLEMENTAL_POLICY_REFERENCE=
PAYROLL_SUPPLEMENTAL_CALCULATION_METHOD=
PAYROLL_ADJUSTMENT_POLICY_REFERENCE=
PAYROLL_ADJUSTMENT_CALCULATION_METHOD=
